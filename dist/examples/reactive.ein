# Big O: Counter update O(1); search/render O(n · C_match). Reference cost model: docs/COMPLEXITY.md
# Memory: O(n) result slots + text.
# Events carry either an increment or a query. The host owns event delivery.
let names = ["Kronecker", "Cauchy", "Noether", "Euler", "Einstein"];
fn update(s, event) = {count: s.count + event.increment, query: event.query};
fn render(s) = {tag: "view", count: s.count, query: s.query, items: search(names, s.query), message: select(len(search(names, s.query)) == 0, "No matching mathematicians. A peaceful outcome.", "")};
let initial = {count: 0, query: ""};
emit render(initial);
